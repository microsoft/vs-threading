<Project Sdk="Microsoft.Build.Traversal">
  <ItemGroup>
    <ProjectReference Include="**\*.csproj" Exclude="NativeAOTCompatibility.Test\**" Publish="false" />

    <ProjectReference Include="NativeAOTCompatibility.Test\NativeAOTCompatibility.Test.csproj" Publish="false" />
  </ItemGroup>
  <Target Name="GetNativeAOTTests" Returns="@(_NativeAOTTest)">
    <MSBuild Projects="@(ProjectReference)" Targets="GetNativeAOTTestVariants" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_NativeAOTTest" />
    </MSBuild>
    <ItemGroup>
      <!-- MSBuild copies reference metadata to returned items; native publishes must retain _IsPublishing. -->
      <_NativeAOTTest UndefineProperties=""
                      AdditionalProperties="TargetFramework=%(_NativeAOTTest.TargetFramework)" />
    </ItemGroup>
  </Target>
  <Target Name="PublishNativeAOTTests" AfterTargets="Publish" DependsOnTargets="GetNativeAOTTests">
    <MSBuild Projects="@(_NativeAOTTest)" Targets="Publish"
             Properties="NativeAOT=true;_IsPublishing=true"
             BuildInParallel="true" />
    <MSBuild Projects="NativeAOTCompatibility.Test\NativeAOTCompatibility.Test.csproj" Targets="Publish"
             Properties="TargetFramework=net10.0" />
    <MSBuild Projects="NativeAOTCompatibility.Test\NativeAOTCompatibility.Test.csproj" Targets="Publish"
             Properties="TargetFramework=net10.0-windows" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </Target>
</Project>
